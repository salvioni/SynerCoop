VITE_API_URL=http://localhost:4000

# Client ID OAuth 2.0 do Google (mesmo client usado no GOOGLE_CLIENT_ID do backend).
# Deixe vazio para ocultar o botão "Entrar com Google".
VITE_GOOGLE_CLIENT_ID=

# App ID do Facebook (mesmo valor usado no FACEBOOK_APP_ID do backend).
# Deixe vazio para ocultar o botão "Entrar com Facebook".
VITE_FACEBOOK_APP_ID=
